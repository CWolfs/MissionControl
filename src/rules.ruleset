<?xml version="1.0" encoding="utf-8"?>
<RuleSet Name="MissionControl Modding Rules" ToolsVersion="16.0">
  <!-- Rules focused on catching actual bugs and performance issues, not style -->
  <Rules AnalyzerId="Microsoft.CodeAnalysis.CSharp" RuleNamespace="Microsoft.CodeAnalysis.CSharp">
    <Rule Id="CS1591" Action="None" /> <!-- Missing XML comment - not needed for mods -->
  </Rules>
  
  <Rules AnalyzerId="Microsoft.CodeAnalysis.NetAnalyzers" RuleNamespace="Microsoft.CodeAnalysis.NetAnalyzers">
    <!-- Performance & Bug Detection -->
    <Rule Id="CA1031" Action="Info" /> <!-- Don't catch general exceptions (helpful for mod debugging) -->
    <Rule Id="CA1822" Action="Info" /> <!-- Mark members as static (performance) -->
    <Rule Id="CA2000" Action="Warning" /> <!-- Dispose objects before losing scope (memory leaks) -->
    <Rule Id="CA1835" Action="Info" /> <!-- Prefer Memory/Span-based overloads (performance) -->
    <Rule Id="CA1851" Action="Info" /> <!-- Possible multiple enumerations (performance) -->
    <Rule Id="CA1860" Action="Info" /> <!-- Avoid using 'Enumerable.Any()' extension method (performance) -->
    
    <!-- Turn off rules that don't matter for modding -->
    <Rule Id="CA2007" Action="None" /> <!-- ConfigureAwait not needed in mods -->
    <Rule Id="CA1303" Action="None" /> <!-- Localization not needed for mods -->
    <Rule Id="CA1307" Action="None" /> <!-- StringComparison often not relevant -->
    <Rule Id="CA1716" Action="None" /> <!-- Identifier conflicts with keyword -->
    <Rule Id="CA1720" Action="None" /> <!-- Identifier contains type name -->
    <Rule Id="CA1056" Action="None" /> <!-- URI properties should not be strings -->
    <Rule Id="CA1054" Action="None" /> <!-- URI parameters should not be strings -->
  </Rules>
  
  <!-- Roslynator rules for code quality -->
  <Rules AnalyzerId="Roslynator.CSharp.Analyzers" RuleNamespace="Roslynator.CSharp.Analyzers">
    <Rule Id="RCS1077" Action="Info" /> <!-- Optimize LINQ method call -->
    <Rule Id="RCS1146" Action="Info" /> <!-- Use conditional access -->
    <Rule Id="RCS1179" Action="Info" /> <!-- Use return instead of assignment -->
    <Rule Id="RCS1197" Action="Info" /> <!-- Optimize StringBuilder.Append/AppendLine call -->
  </Rules>
</RuleSet>