{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MC: Build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "src/MissionControl.csproj"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "MC: Copy Assets",
